# ─── FACEBOOK ────────────────────────────────────────────────────────────
EXPO_PUBLIC_FACEBOOK_APP_ID=1526133312174343

# ─── GOOGLE ──────────────────────────────────────────────────────────────
# iOS: Get from Google Cloud Console → Credentials → OAuth 2.0 Client IDs
# Format: com.googleusercontent.apps.YOUR_CLIENT_ID
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Android: Get from Google Cloud Console → Credentials → OAuth 2.0 Client IDs
# Format: YOUR_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Web: Get from Google Cloud Console → Credentials → OAuth 2.0 Client IDs
# Format: YOUR_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# ─── STRIPE ──────────────────────────────────────────────────────────────
# Get from Stripe Dashboard → Developers → API Keys
# Use pk_test_ for development, pk_live_ for production
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── SENTRY (Optional) ──────────────────────────────────────────────────
# EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn

# ─── APP CONFIG ──────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_VERSION=2.0.0