# ═══════════════════════════════════════════════════════════════════════
#  LittleLoom — Environment Configuration
#  ⚠️  NEVER commit this file. It contains secrets.
#  ⚠️  After any edit here, run:  npx expo start --clear
#      and REINSTALL the app on your device (uninstall first).
# ═══════════════════════════════════════════════════════════════════════

# ─── SUPABASE ───────────────────────────────────────────────────────────
# Project ref: qoozrrljpgsyhxfqxnzf
# SDK in use: @supabase/supabase-js@2.117.1  (>= 2.45.0)
# Using the NEW publishable key format — recommended by Supabase and
# rotatable without breaking JWTs. Both keys work with this SDK version.
EXPO_PUBLIC_SUPABASE_URL=https://qoozrrljpgsyhxfqxnzf.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_RNzz7jvsGmrRp9c94JiPuA_ooZt_gmm

# ─── FACEBOOK ───────────────────────────────────────────────────────────
EXPO_PUBLIC_FACEBOOK_APP_ID=1526133312174343

# ─── GOOGLE ─────────────────────────────────────────────────────────────
# iOS:     Get from Google Cloud Console → Credentials → OAuth 2.0 Client IDs
#          Format: com.googleusercontent.apps.YOUR_CLIENT_ID
# Android: Format: YOUR_CLIENT_ID.apps.googleusercontent.com
# Web:     Format: YOUR_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# ─── STRIPE ─────────────────────────────────────────────────────────────
# ⚠️  LIVE KEY — only use when ready to accept real payments.
#     For development, switch to a test key: pk_test_...
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_51NhTSlAAGwKLZ98N5rsOcVQ85b6f32oKSq1uIwJrt4sIli0OWduQxZoMw7XPHyLmtI0qlYGf3M5gs1W1b2wkjbxF00hHSrD4rC

# ─── SENTRY (Optional) ──────────────────────────────────────────────────
# EXPO_PUBLIC_SENTRY_DSN=

# ─── APP CONFIG ─────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_VERSION=2.0.0