{
  "cli": {
    "version": ">= 18.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "22.13.0",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleFlags": "--no-daemon"
      },
      "env": {
        "EXPO_USE_FAST_RESOLVER": "1"
      }
    },
    "development-simulator": {
      "node": "22.13.0",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleFlags": "--no-daemon"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "node": "22.13.0",
      "distribution": "internal"
    },
    "production": {
      "node": "22.13.0",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}