{
  "cli": {
    "version": ">= 18.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "22.13.0",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_USE_FAST_RESOLVER": "1",
        "EXPO_DOCTOR_SKIP": "1",
        "EAS_SKIP_AUTO_FINGERPRINT": "1"
      }
    },
    "dev-fast": {
      "node": "22.13.0",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_USE_FAST_RESOLVER": "1",
        "EXPO_DOCTOR_SKIP": "1",
        "EAS_SKIP_AUTO_FINGERPRINT": "1"
      }
    },
    "preview": {
      "node": "22.13.0",
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EAS_SKIP_AUTO_FINGERPRINT": "1",
        "EXPO_USE_FAST_RESOLVER": "1",
        "EXPO_DOCTOR_SKIP": "1"
      }
    },
    "production": {
      "node": "22.13.0",
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EAS_SKIP_AUTO_FINGERPRINT": "1",
        "EXPO_USE_FAST_RESOLVER": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}